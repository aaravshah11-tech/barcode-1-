{
  "name": "homebase",
  "version": "1.0.0",
  "private": true,
  "description": "HomeBase: library, inventory, sports stats, match photography and golf swing analysis. Phone + computer in sync.",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node tests/live-lookup.mjs",
    "sw": "node scripts/update-sw.mjs",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.12",
    "aedes": "0.51.3",
    "playwright": "1.63.0",
    "websocket-stream": "5.5.2",
    "axe-core": "4.10.2"
  },
  "engines": {
    "node": ">=20"
  }
}

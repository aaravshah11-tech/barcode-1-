{
  "name": "HomeBase",
  "short_name": "HomeBase",
  "description": "Your home toolkit: library, inventory, sports stats, match photography and golf swing analysis.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f3ee",
  "theme_color": "#b4532a",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan a book",
      "url": "./#/library/scan"
    },
    {
      "name": "Inventory: add / scan",
      "url": "./#/inventory/add"
    },
    {
      "name": "Sports",
      "url": "./#/sports"
    },
    {
      "name": "Record a golf swing",
      "url": "./#/golf"
    }
  ]
}